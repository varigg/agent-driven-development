# docs/addw.env — this repo's own ADDW project configuration (dogfood).
# Shell-sourceable; scripts source it at runtime — never edit a skill to
# change these values. Only the keys this repo actually consumes exist yet;
# installed projects get the full set from addw-init.
#
# Install generation — bumped only by structural upgrades (see UPGRADING.md).
# This repo is the product rather than an install, so doctor still reports the
# living docs it has no reason to carry; the marker is here because the
# generation is a fact about the tree either way.
ADDW_SCHEMA=5

# The branch tickets merge into. Consumed by addw-implement (branch base, PR
# base) and by the code-review prompt, which derives the merge base from it —
# unset, that prompt falls back to `main` and silently reviews the wrong range.
ADDW_MAIN_BRANCH="master"

ADDW_ADR_DIR="docs/adr"

# This repo names its own tree; an install names the shipped
# `.claude/skills/lib/...` path, which here is a gitignored symlink farm and
# would not resolve in a fresh clone.
ADDW_ADR_TEMPLATE="skills/lib/templates/adr.md"

# Testing-gate recipes (run by skills/lib/gate/gate.sh):
ADDW_RECIPE_LINT="git ls-files '*.sh' | xargs shellcheck --severity=warning"
# Plain bash has no typecheck step; the empty key keeps the skip visible:
ADDW_RECIPE_TYPECHECK=""
# The whole suite runs in seconds, so affected-selection is moot here and
# the recipe takes no {paths}:
ADDW_RECIPE_TESTS_AFFECTED="bash tests/run.sh"
