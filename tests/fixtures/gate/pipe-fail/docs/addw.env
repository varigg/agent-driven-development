# Gate fixture: the lint recipe is a pipeline whose non-final component
# fails. The recipe shell runs with pipefail, so the rung must FAIL with the
# failing component's status rather than cat's 0 — and the tests rung after
# it must still run (its sentinel proves it).
ADDW_RECIPE_LINT='false | cat'
ADDW_RECIPE_TYPECHECK=""
ADDW_RECIPE_TESTS_AFFECTED="echo tests-ran-after-pipe-fail"
