# Gate fixture: ADDW_RECIPE_LINT absent (not empty — deleted). The gate must
# refuse before any rung runs; the sentinel recipes record into $GATE_OUT
# (exported by the test), and a file there proves a recipe ran.
ADDW_RECIPE_TYPECHECK='echo typecheck-ran > "$GATE_OUT"'
ADDW_RECIPE_TESTS_AFFECTED='echo tests-ran > "$GATE_OUT"'
