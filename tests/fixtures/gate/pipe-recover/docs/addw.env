# Gate fixture: a pipeline with explicit recipe-level recovery. pipefail
# makes `false | cat` fail, and `|| true` is the documented way a recipe
# tolerates that on purpose — ordinary shell semantics, no errexit imposed.
ADDW_RECIPE_LINT='false | cat || true'
ADDW_RECIPE_TYPECHECK="echo typecheck-ran"
ADDW_RECIPE_TESTS_AFFECTED="echo tests-ran"
