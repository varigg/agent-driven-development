# Gate fixture: the tests recipe takes the selected paths via the {paths}
# placeholder and records what it received in $GATE_OUT (exported by the
# test). Single-quoted: the $ must reach the recipe literally, and the config
# grammar rejects $ inside double quotes. The other rungs are explicit skips.
ADDW_RECIPE_LINT=""
ADDW_RECIPE_TYPECHECK=""
ADDW_RECIPE_TESTS_AFFECTED='echo {paths} > "$GATE_OUT"'
